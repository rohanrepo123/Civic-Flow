REDIS_URL=redis://localhost:6379/0
BROWSER_SESSION_PREFIX=civicflow:browser:
SESSION_TTL_SECONDS=1800
# Live Chromium by default. Mock mode must be explicitly selected for UI-only demos.
CIVICFLOW_BROWSER_RUNTIME=playwright
BROWSER_HEADLESS=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CIVICFLOW_ALLOW_LOCAL_MOCK=false
