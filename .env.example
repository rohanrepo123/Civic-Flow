# Shared settings
APP_ENV=development
LOG_LEVEL=INFO
AUTH_TOKEN_SECRET=replace-with-a-random-local-secret

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://civicflow:civicflow@db:5432/civicflow

# Member 2 agent: Ollama is the default and stays local.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=nemotron-3-super:cloud
# Optional Internet fallback for official .gov.in sources; vector retrieval remains primary.
TAVILY_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0

# Hosted OpenAI is disabled for this setup. Keep these blank unless you explicitly enable it later.
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_ALLOW_DOCUMENT_DATA=false
LLM_CHAT_COMPLETIONS_URL=

# Local semantic search. Model downloads only when explicitly requested.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
EMBEDDING_ALLOW_DOWNLOAD=false

# Set EMBEDDING_PROVIDER=openai_compatible only for an explicitly approved API.
EMBEDDING_API_KEY=
EMBEDDING_URL=
BROWSER_WORKER_URL=http://browser-worker:8001

# Browser worker
BROWSER_WORKER_HOST=0.0.0.0
BROWSER_WORKER_PORT=8001
BROWSER_WORKER_API_TOKEN=
BROWSER_ALLOWED_DOMAINS=
BROWSER_FILE_REFERENCE_DOMAINS=
BROWSER_SESSION_TTL_SECONDS=1800
